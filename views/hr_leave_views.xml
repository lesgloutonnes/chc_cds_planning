<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filtre visuel des types de congés à la création/édition d'une demande -->
    <record id="hr_leave_view_form_filter_leave_types" model="ir.ui.view">
        <field name="name">hr.leave.form.filter.leave.types</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="context">{'chc_filter_employee_leave_types': 1}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
